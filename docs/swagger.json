        "/subsc/reports/{pet_id}": {
            "get": {
                "security": [{"BearerAuth": []}],
                "description": "指定したペットIDに紐づく全レポートを日時の新しい順で取得します。",
                "produces": ["application/json"],
                "tags": ["reports"],
                "summary": "ペットの全レポート取得",
                "parameters": [{
                    "type": "string",
                    "description": "ペットID",
                    "name": "pet_id",
